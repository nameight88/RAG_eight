# Vector DB
VECTOR_DB_PATH=data/vector_db/fss_sanctions
VECTOR_DB_TYPE=FAISS

# CORS (쉼표 구분)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
